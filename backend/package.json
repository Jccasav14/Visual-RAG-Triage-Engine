{
  "name": "visual-rag-triage-backend",
  "version": "1.0.0",
  "description": "Backend Monorepo for Visual-RAG Triage Engine with PostgreSQL, Google Auth, NestJS microservices and Swagger UI",
  "main": "dist/apps/api-gateway/main.js",
  "scripts": {
    "build": "tsc",
    "start:gateway": "node dist/api-gateway/src/main.js",
    "start:identity": "node dist/identity-service/src/main.js",
    "start:triage": "node dist/triage-core-service/src/main.js",
    "start:llm": "node dist/llm-orchestrator/src/main.js",
    "start:all": "concurrently \"npm run start:identity\" \"npm run start:triage\" \"npm run start:llm\" \"npm run start:gateway\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/typeorm": "^10.0.1",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.1",
    "google-auth-library": "^9.5.0",
    "ioredis": "^5.3.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "sqlite3": "^6.0.1",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.0",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
